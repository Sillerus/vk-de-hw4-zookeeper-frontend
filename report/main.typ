#figure(
  table(columns: (0.7fr, 1fr, 1fr, 1.3fr, 1.6fr, 0.6fr), align: (left, right, right, right, left, right),
    table.header([*Сервер*], [*clientPort*], [*порт синхр.*], [*порт выборов*], [*dataDir*], [*myid*]),
    [zk1], [2181], [2888], [3888], [`/opt/hw4-zk/zk1/data`], [1],
    [zk2], [2182], [2889], [3889], [`/opt/hw4-zk/zk2/data`], [2],
